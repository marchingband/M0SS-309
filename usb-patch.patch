+void CDWHCIDevice::CompleteRequest (CUSBRequest *pURB)
+{
+	assert (pURB != 0);
+
+#ifndef USE_USB_FIQ
+	pURB->CallCompletionRoutine ();
+#else
+	if (pURB->IsCompleteImmediately ())
+	{
+		pURB->CallCompletionRoutine ();
+	}
+	else
+	{
+		m_CompletionQueue.Enqueue (pURB);
+	}
+#endif
+}
