import("stdfaust.lib");

variable_osc = environment {

    i_blep_next(t) = out 
    with {
        t1 = 0.5 * t;
        t2 = t1 * t1;
        t4 = t2 * t2;
        out = 0.1875 - t1 + 1.5 * t2 - t4;
    };
    i_blep_this(t) = i_blep_next(1.0 - t);
    blep_this(x) = 0.5 * x * x;
    blep_next(x) = -0.5 * (1.0 - x) * (1.0 - x);
    sq(phase, pw) = phase >= pw;
    saw(phase) = phase;
    var(ph, pw, s_up, s_down, t_amt, s_amt) = out with {
        saw = ph;
        sq = ba.if(ph < pw, 0.0, 1.0);
        tri = ba.if(ph < pw, ph * s_up, 1.0 - (ph - pw) * s_down);
        saw_ = saw + (sq - saw) * s_amt;
        out = saw_ + (tri - saw) * t_amt;
    };

    hs_fm_osc_pair(_m_freq, s_freq, _m_pw, _s_pw, m_ws, s_ws, sync, fm) = (m_next, s_next, m_high, s_high, m_phase, s_phase, m_prev_pw, s_prev_pw, m_out, s_out) : !,!,!,!,!,!,!,!,_,_ : *(2),*(2) : -(1),-(1)
    letrec{
        'm_prev_pw = m_pw;
        's_prev_pw = s_pw;
    // SLAVE.
        's_out = 
            s_next 
            - ba.if(
                reset,
                var(fmod(slave_phase_at_reset, 1.0), s_pw, s_slope_up, s_slope_down, s_tri_amount, s_sq_amount) * blep_this(reset_time),
                0
            )
            + ba.if(
                (transition_during_reset + (reset == 0)) > 0,
                ba.if(
                    s_high,
                    ba.if(
                        s_phase_ >= 1.0,
                        (s_triangle_step * i_blep_this(s_phase__ / s_step)) - ((1.0 - s_tri_amount) * blep_this(s_phase__ / s_step)),
                        0
                    ),
                    ba.if(
                        s_phase__ >= s_pw,
                        (s_sq_amount * blep_this((s_phase__ - s_pw) / (s_prev_pw - s_pw + s_step))) - (s_triangle_step * i_blep_this((s_phase__ - s_pw) / (s_prev_pw - s_pw + s_step))),
                        0
                    )
                ),
                0
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
                slave_phase_at_reset = s_phase + (1.0 - reset_time) * s_step;
                transition_during_reset = ((slave_phase_at_reset >= 1.0) + ((s_high == 0) + (slave_phase_at_reset >= s_pw) == 2)) > 0;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
                s_triangle_step = (s_slope_up + s_slope_down) * s_step * s_tri_amount;
            };
        's_next = 
            var(s_phase___, s_pw, s_slope_up, s_slope_down, s_tri_amount, s_sq_amount) 
            - ba.if(
                reset,
                var(fmod(slave_phase_at_reset, 1.0), s_pw, s_slope_up, s_slope_down, s_tri_amount, s_sq_amount) * blep_next(reset_time),
                0
            )
            + ba.if(
                (transition_during_reset + (reset == 0)) > 0,
                ba.if(
                    s_high,
                    ba.if(
                        s_phase_ >= 1.0,
                        (s_triangle_step * i_blep_next(s_phase__ / s_step)) - ((1.0 - s_tri_amount) * blep_next(s_phase__ / s_step)),
                        0
                    ),
                    ba.if(
                        s_phase__ >= s_pw,
                        (s_sq_amount * blep_next((s_phase__ - s_pw) / (s_prev_pw - s_pw + s_step))) - (s_triangle_step * i_blep_next((s_phase__ - s_pw) / (s_prev_pw - s_pw + s_step))),
                        0
                    )
                ),
                0
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
                slave_phase_at_reset = s_phase + (1.0 - reset_time) * s_step;
                transition_during_reset = (slave_phase_at_reset >= 1.0) + ((s_high == 0) + (slave_phase_at_reset >= s_pw) == 2) > 0;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
                s_phase___ = ba.if(reset, reset_time * s_step, s_phase__);
                s_triangle_step = (s_slope_up + s_slope_down) * s_step * s_tri_amount;
            };
        's_phase = 
            ba.if(
                reset,
                reset_time * s_step,
                fmod(s_phase + s_step, 1.0)
            )
            with{
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
            };
        'm_phase = fmod(m_phase + m_step, 1.0)
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
            };
        's_high = 
            ba.if(
                (reset + (s_high + (s_phase_ >= 1.0) == 2) + ((s_high == 0) + (s_phase__ < s_pw) == 2)) > 0, 
                0,
                1
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
            };
    // MASTER.
        'm_out = 
            m_next 
            + ba.if(
                m_high,
                ba.if(
                    m_phase_ >= 1.0,
                    (m_triangle_step * i_blep_this(m_phase__ / m_step)) - ((1.0 - m_tri_amount) * blep_this(m_phase__ / m_step)),
                    0
                ),
                ba.if(
                    m_phase__ >= m_pw,
                    (m_sq_amount * blep_this((m_phase__ - m_pw) / (m_prev_pw - m_pw + m_step))) - (m_triangle_step * i_blep_this((m_phase__ - m_pw) / (m_prev_pw - m_pw + m_step))),
                    0
                )
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
                m_triangle_step = (m_slope_up + m_slope_down) * m_step * m_tri_amount;
            };
        'm_next = 
            var(m_phase__, m_pw, m_slope_up, m_slope_down, m_tri_amount, m_sq_amount) 
            + ba.if(
                m_high,
                ba.if(
                    m_phase_ >= 1.0,
                    (m_triangle_step * i_blep_next(m_phase__ / m_step)) - ((1.0 - m_tri_amount) * blep_next(m_phase__ / m_step)),
                    0
                ),
                ba.if(
                    m_phase__ >= m_pw,
                    (m_sq_amount * blep_next((m_phase__ - m_pw) / (m_prev_pw - m_pw + m_step))) - (m_triangle_step * i_blep_next((m_phase__ - m_pw) / (m_prev_pw - m_pw + m_step))),
                    0
                )
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
                m_triangle_step = (m_slope_up + m_slope_down) * m_step * m_tri_amount;
            };
        'm_high = 
            ba.if(
                (m_high + (m_phase_ >= 1.0) == 2) + ((m_high == 0) + (m_phase__ < m_pw) == 2) > 0, 
                0,
                1
            )
            with {
                m_step = max(0, _m_freq + (s_freq * s_out * fm)) / ma.SR;
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
            };
    }
    with {
        m_max_freq = max(0, _m_freq + (s_freq * fm));
        _m_step = _m_freq / ma.SR;
        s_step = s_freq / ma.SR;
        s_sq_amount = max(s_ws - 0.5, 0.0) * 2.0;
        s_tri_amount = max(1.0 - s_ws * 2.0, 0.0);
        s_slope_up = 1.0 / (s_pw);
        s_slope_down = 1.0 / (1.0 - s_pw);
        s_pw = ba.if(s_step >= 0.25, 0.5, max(s_step * 2.0, min(1.0 - 2.0 * s_step)), _s_pw);
        m_sq_amount = max(m_ws - 0.5, 0.0) * 2.0;
        m_tri_amount = max(1.0 - m_ws * 2.0, 0.0);
        m_slope_up = 1.0 / (m_pw);
        m_slope_down = 1.0 / (1.0 - m_pw);
        m_pw = ba.if(_m_step >= 0.25, 0.5, max(_m_step * 2.0, min(1.0 - 2.0 * _m_step)), _m_pw);
    };


    hard_sync_variable_slave(m_freq, s_freq, _pw, ws, sync) = (next, high, m_phase, s_phase, prev_pw, out) : !,!,!,!,!,_ : _*2-1
    letrec{
        'prev_pw = pw;
        'out = 
            next 
            - ba.if(
                reset,
                var(fmod(slave_phase_at_reset, 1.0), pw, slope_up, slope_down, tri_amount, sq_amount) * blep_this(reset_time),
                0
            )
            + ba.if(
                (transition_during_reset + (reset == 0)) > 0,
                ba.if(
                    high,
                    ba.if(
                        s_phase_ >= 1.0,
                        (triangle_step * i_blep_this(s_phase__ / s_step)) - ((1.0 - tri_amount) * blep_this(s_phase__ / s_step)),
                        0
                    ),
                    ba.if(
                        s_phase__ >= pw,
                        (sq_amount * blep_this((s_phase__ - pw) / (prev_pw - pw + s_step))) - (triangle_step * i_blep_this((s_phase__ - pw) / (prev_pw - pw + s_step))),
                        0
                    )
                ),
                0
            )
            with {
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
                slave_phase_at_reset = s_phase + (1.0 - reset_time) * s_step;
                transition_during_reset = ((slave_phase_at_reset >= 1.0) + ((high == 0) + (slave_phase_at_reset >= pw) == 2)) > 0;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
                triangle_step = (slope_up + slope_down) * s_step * tri_amount;
            };
        'next = 
            var(s_phase___, pw, slope_up, slope_down, tri_amount, sq_amount) 
            - ba.if(
                reset,
                var(fmod(slave_phase_at_reset, 1.0), pw, slope_up, slope_down, tri_amount, sq_amount) * blep_next(reset_time),
                0
            )
            + ba.if(
                (transition_during_reset + (reset == 0)) > 0,
                ba.if(
                    high,
                    ba.if(
                        s_phase_ >= 1.0,
                        (triangle_step * i_blep_next(s_phase__ / s_step)) - ((1.0 - tri_amount) * blep_next(s_phase__ / s_step)),
                        0
                    ),
                    ba.if(
                        s_phase__ >= pw,
                        (sq_amount * blep_next((s_phase__ - pw) / (prev_pw - pw + s_step))) - (triangle_step * i_blep_next((s_phase__ - pw) / (prev_pw - pw + s_step))),
                        0
                    )
                ),
                0
            )
            with {
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
                slave_phase_at_reset = s_phase + (1.0 - reset_time) * s_step;
                transition_during_reset = (slave_phase_at_reset >= 1.0) + ((high == 0) + (slave_phase_at_reset >= pw) == 2) > 0;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
                s_phase___ = ba.if(reset, reset_time * s_step, s_phase__);
                triangle_step = (slope_up + slope_down) * s_step * tri_amount;
            };
        's_phase = 
            ba.if(
                reset,
                reset_time * s_step,
                fmod(s_phase + s_step, 1.0)
            )
            with{
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                m_phase__ = fmod(m_phase_, 1.0);
                reset_time = m_phase__ / m_step;
            };
        'm_phase = fmod(m_phase + m_step, 1.0);
        'high = 
            ba.if(
                (reset + (high + (s_phase_ >= 1.0) == 2) + ((high == 0) + (s_phase__ < pw) == 2)) > 0, 
                0,
                1
            )
            with {
                m_phase_ = m_phase + m_step;
                reset = (m_phase_ >= 1.0) + sync == 2;
                s_phase_ = s_phase + s_step;
                s_phase__ = fmod(s_phase_, 1.0);
            };
    }
    with {
        m_step = m_freq / ma.SR;
        s_step = s_freq / ma.SR;
        sq_amount = max(ws - 0.5, 0.0) * 2.0;
        tri_amount = max(1.0 - ws * 2.0, 0.0);
        slope_up = 1.0 / (pw);
        slope_down = 1.0 / (1.0 - pw);
        pw = ba.if(s_step >= 0.25, 0.5, max(s_step * 2.0, min(1.0 - 2.0 * s_step)), _pw);
    };

    hard_sync_variable_master(m_freq, _pw, ws) = (next, high, m_phase, prev_pw, out) : !,!,!,!,_ : _*2-1
    letrec{
        'prev_pw = pw;
        'out = 
            next 
            + ba.if(
                high,
                ba.if(
                    m_phase_ >= 1.0,
                    (triangle_step * i_blep_this(m_phase__ / m_step)) - ((1.0 - tri_amount) * blep_this(m_phase__ / m_step)),
                    0
                ),
                ba.if(
                    m_phase__ >= pw,
                    (sq_amount * blep_this((m_phase__ - pw) / (prev_pw - pw + m_step))) - (triangle_step * i_blep_this((m_phase__ - pw) / (prev_pw - pw + m_step))),
                    0
                )
            )
            with {
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
                triangle_step = (slope_up + slope_down) * m_step * tri_amount;
            };
        'next = 
            var(m_phase__, pw, slope_up, slope_down, tri_amount, sq_amount) 
            + ba.if(
                high,
                ba.if(
                    m_phase_ >= 1.0,
                    (triangle_step * i_blep_next(m_phase__ / m_step)) - ((1.0 - tri_amount) * blep_next(m_phase__ / m_step)),
                    0
                ),
                ba.if(
                    m_phase__ >= pw,
                    (sq_amount * blep_next((m_phase__ - pw) / (prev_pw - pw + m_step))) - (triangle_step * i_blep_next((m_phase__ - pw) / (prev_pw - pw + m_step))),
                    0
                )
            )
            with {
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
                triangle_step = (slope_up + slope_down) * m_step * tri_amount;
            };
        'm_phase = fmod(m_phase + m_step, 1.0);
        'high = 
            ba.if(
                (high + (m_phase_ >= 1.0) == 2) + ((high == 0) + (m_phase__ < pw) == 2) > 0, 
                0,
                1
            )
            with {
                m_phase_ = m_phase + m_step;
                m_phase__ = fmod(m_phase_, 1.0);
            };
    }
    with {
        m_step = m_freq / ma.SR;
        sq_amount = max(ws - 0.5, 0.0) * 2.0;
        tri_amount = max(1.0 - ws * 2.0, 0.0);
        slope_up = 1.0 / (pw);
        slope_down = 1.0 / (1.0 - pw);
        pw = ba.if(m_step >= 0.25, 0.5, max(m_step * 2.0, min(1.0 - 2.0 * m_step)), _pw);
    };

    // m = hslider("m", 100, 10, 10000, 0.01) : si.smoo;
    // s = hslider("s", 100, 10, 10000, 0.01) : si.smoo;
    // pw = hslider("pw", 1.0, 0.0, 1.0, 0.001) : si.smoo;
    // ws = hslider("ws", 0.0, 0.0, 1.0, 0.001) : si.smoo; // 0 == triangle, 1 == square


    // process = hard_sync_variable_master(m, pw, ws), hard_sync_variable_slave(m, s, pw, ws) :> *(0.5);
};