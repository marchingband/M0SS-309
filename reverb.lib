import("stdfaust.lib");

reverb = environment {
    delay_time = 0.2;        // 0.1 - 60 sec
    damping = 0;             // 0 - 1
    size = 1;                // 0.5 - 3
    early_diffusion = 0.5;   // 0 - 1
    mod_depth = 0.1;         // 0 - 1
    mod_freq = 2;            // 0 - 10 hz
    reverb(fb) = re.greyhole(
        delay_time,
        damping,
        size,
        early_diffusion,
        fb,
        mod_depth,
        mod_freq
    );
};