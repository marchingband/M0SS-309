import("stdfaust.lib");

pitch_math = environment {
    // Split 2^x into an exact integer-octave scale and a polynomial on
    // [-0.5, 0.5]. The 256-entry table is generated at initialization;
    // no pow or floor call is needed in the audio loop.
    // Saturate outside the normal-float exponent range, which covers the
    // nominal synth modulation ranges including combined poly-mod routes.
    exp2(x) = rdtable(256, octave_scale, (octave + 126) & 255) * fractional_scale
    with {
        // Comparisons avoid out-of-line fminf/fmaxf calls on this target.
        // The outer comparison also gives NaN a safe table index.
        bounded = ba.if(x >= -126.0, ba.if(x <= 127.0, x, 127.0), -126.0);
        octave = int(bounded + ba.if(bounded >= 0.0, 0.5, -0.5));
        fraction = bounded - float(octave);
        // Only entries 0..253 are used; pad to a power of two so the index
        // mask proves table safety without generated min/max function calls.
        octave_scale = pow(2.0, min(127.0, float(ba.time) - 126.0));

        // Degree-six Taylor polynomial for exp(log(2) * fraction).
        fractional_scale = 1.0 + fraction * (0.6931471805599453
            + fraction * (0.2402265069591007
            + fraction * (0.05550410866482158
            + fraction * (0.009618129107628477
            + fraction * (0.001333355814642844
            + fraction * 0.0001540353039338161)))));
    };

    cent2ratio(cents) = exp2(cents / 1200.0);

    // Preserve the standard MIDI-note mapping, including fractional notes
    // from smoothed transpose and mono detuning, before the glide filter.
    midikey2hz(note) = 440.0 * exp2((note - 69.0) / 12.0);
};
