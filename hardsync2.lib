
import("stdfaust.lib");

hs = environment {

hs_sq(m_freq, s_freq, m_duty, s_duty) = m_out, s_out
with {
    m_period = ma.SR / m_freq;
    m_step = os.phasor(m_period, ma.SR / m_period);
    m_duty_period = m_period * m_duty;
    m_base = ba.if(m_step < m_duty_period, 1, -1);
    m_phase = m_step / m_period;
    m_edge_rising = polyblep(m_period, m_step);
    m_edge_falling = polyblep(m_period, ma.modulo(m_step - m_duty_period, m_period));
    m_out = m_base - m_edge_falling + m_edge_rising;
    m_reset = m_step < 1;

    s_period = ma.SR / s_freq;
    s_duty_period = s_period * s_duty;
    s_step = os.hsp_phasor(s_period, ma.SR / s_period, m_reset, m_reset * m_phase * (m_period / s_period));
    s_base = ba.if(s_step < s_duty_period, 1, -1);
    s_edge_rising = polyblep(s_period, s_step);
    s_edge_falling = polyblep(s_period, ma.modulo(s_step - s_duty_period, s_period));
    s_out = s_base + s_edge_rising - s_edge_falling + ba.if(s_step >= s_duty_period, m_edge_rising, 0);

    out = (s_out + m_out) * 0.5;
};

hs_saw(m_freq, s_freq) = (m, s, r) : poly, poly, _ : D
letrec {
    'r = m < m';
    's = ba.if(m < m', 0, (s + p_s, 1.0 : fmod));
    'm = m + p_m, 1 : fmod;
}
with {
    p_m = (1.0/(float(ma.SR)/float(m_freq)));
    p_s = (1.0/(float(ma.SR)/float(s_freq)));
    poly(x) = (x * 2 - 1) * (x * 2 - 1);
    D(b, a, c) = ba.if(c, b1, a1), b1
    with {
        a1 = ((a - a')/(2.0/(float(ma.SR)/float(s_freq)))/2.0);
        b1 = ((b - b')/(2.0/(float(ma.SR)/float(m_freq)))/2.0);
    };
};

polyblep(period, step) = (0, L(step), R(step - period)) : select3(sel)
with {
    sel = (step < 1) + 2 * (step > (period - 1));
    L(x) = 2*x - x*x - 1; // Used near the left end of the interval
    R(x) = 2*x + x*x + 1; // Used near the right end of the interval
};

hs_sq_solo(m_freq, s_freq, m_duty, s_duty) = out
with {
    m_period = ma.SR / m_freq;
    m_step = os.phasor(m_period, ma.SR / m_period);
    m_duty_period = m_period * m_duty;
    m_base = ba.if(m_step < m_duty_period, -1, 1);
    m_phase = m_step / m_period;
    m_edge_rising = polyblep(m_period, m_step);
    m_edge_falling = polyblep(m_period, ma.modulo(m_step - m_duty_period, m_period));
    m_out = m_base - m_edge_falling + m_edge_rising;
    m_reset = m_step < 1;

    s_period = ma.SR / s_freq;
    s_duty_period = s_period * s_duty;
    s_step = os.hsp_phasor(s_period, ma.SR / s_period, m_reset, m_reset * m_phase * (m_period / s_period));
    s_base = ba.if(s_step < s_duty_period, -1, 1);
    s_edge_rising = polyblep(s_period, s_step);
    s_edge_falling = polyblep(s_period, ma.modulo(s_step - s_duty_period, s_period));
    s_out = s_base + s_edge_rising - s_edge_falling + ba.if(s_step >= s_duty_period, m_edge_rising, 0);

    out = s_out;
};

hs_saw_solo(m_freq, s_freq) = m, s, r : poly, poly, _ : D : _, ! :> _
letrec {
    'r = m < m';
    's = ba.if(m < m', 0, (s + p, 1.0 : fmod))
    with {
        p = (1.0/(float(ma.SR)/float(s_freq)));
    };
    'm = m + p, 1 : fmod
    with {
        p = (1.0/(float(ma.SR)/float(m_freq)));
    };
}
with {
    poly(x) = (x * 2 - 1) * (x * 2 - 1);
    D(b, a, c) = ba.if(c, b1, a1), b1
    with {
        a1 = ((a - a')/(2.0/(float(ma.SR)/float(s_freq)))/2.0);
        b1 = ((b - b')/(2.0/(float(ma.SR)/float(m_freq)))/2.0);
    };
};

master_with_solo(m_f, s_f, m_w, s_w, m_pw, s_pw) = os.sawtooth(m_f), os.pulsetrain(m_f, m_pw) : select2(m_w);
slave_with_solo(m_f, s_f, m_w, s_w, m_pw, s_pw) = hs_saw_solo(m_f, s_f), hs_sq_solo(m_f, s_f, m_pw, s_pw) : select2(s_w);

// with_solo = master_with_solo, slave_with_solo :> *(0.5) ;

m_sq(m_f, s_f, m_pw, s_pw) = hs_sq(m_f, s_f, m_pw, s_pw) : select2(1) ;
s_sq(m_f, s_f, m_pw, s_pw) = hs_sq(m_f, s_f, m_pw, s_pw) : select2(0) ;
m_saw(m_f, s_f) = hs_saw(m_f, s_f) : select2(1) ;
s_saw(m_f, s_f) = hs_saw(m_f, s_f) : select2(0);
master_blended(m_f, s_f, m_w, s_w, m_pw, s_pw) = m_saw(m_f, s_f), m_sq(m_f, s_f, m_pw, s_pw) : select2(m_w);
slave_blended(m_f, s_f, m_w, s_w, m_pw, s_pw) = s_saw(m_f, s_f), s_sq(m_f, s_f, m_pw, s_pw) : select2(s_w);

// blended = master_blended, slave_blended :> *(0.5);

master(m_f, s_f, m_w, s_w, m_pw, s_pw) = master_with_solo(m_f, s_f, m_w, s_w, m_pw, s_pw), master_blended(m_f, s_f, m_w, s_w, m_pw, s_pw) : select2(m_w == s_w);
slave(m_f, s_f, m_w, s_w, m_pw, s_pw) = slave_with_solo(m_f, s_f, m_w, s_w, m_pw, s_pw), slave_blended(m_f, s_f, m_w, s_w, m_pw, s_pw) : select2(m_w == s_w);

};
